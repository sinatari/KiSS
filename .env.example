# Database
# IMPORTANT: Must start with postgresql:// or postgres:// exactly as shown below.
# Use the PUBLIC connection string from Railway (DATABASE_PUBLIC_URL), not the internal
# postgres.railway.internal host — that only works from inside Railway's own network.
# Use straight quotes (") not smart/curly quotes, and keep the whole value on one line.
# If your password contains special characters (@ : / # %), URL-encode them.
DATABASE_URL="postgresql://user:password@localhost:5432/kiss?schema=public"

# Email (Resend)
# Get a key from https://resend.com/api-keys — never commit or paste this key anywhere public.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
NOTIFICATION_EMAIL="hello@kiss-weddings.se"

# App
NEXT_PUBLIC_SITE_URL="https://kiss-weddings.se"
